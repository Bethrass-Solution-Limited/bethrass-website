# ─────────────────────────────────────────────────────────────────────────
# Bethrass Marketing Website — Environment Variables
#
# Copy this file to `.env.local` for local development, and configure the
# same keys in the Vercel project settings for preview/production.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# ─────────────────────────────────────────────────────────────────────────

# Canonical site URL — used for metadata, canonical links, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL="https://bethrass.com"

# ── Future Bethrass applications (deployed SEPARATELY on AWS) ──────────────
# The website only LINKS to these products; it never imports their code.
# Leave a value blank until the product is live — blank shows an on-site
# "coming soon" fallback. Launching a product = set its URL here (no code change).
NEXT_PUBLIC_URS_APP_URL=""       # URS — Unified Record System
NEXT_PUBLIC_LIN_APP_URL=""       # LIN Platform
NEXT_PUBLIC_ACADEMY_URL=""       # Bethrass Academy
NEXT_PUBLIC_DOCS_URL=""          # Documentation portal

# ── Contact form (DEFERRED — not wired yet) ───────────────────────────────
# Planned path: Resend transactional email (server-side, not a public API).
# Uncomment and configure when the contact form backend is implemented.
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL="contact@bethrass.com"
